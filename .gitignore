# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Sheets API credentials (NEVER commit these!)
google-sheets-credentials.json
*credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated cache files (large, rebuilt on sync)
src/data/cached-sheets-parsed.json
src/data/cached-sheets-data.json
src/data/temp-sheet-download.csv
src/data/sync-status/
